y2018d3←{
	x←⊃⎕NGET ⍵
	x[⍸x∊'@:x']←','
	⎕CSV x 'S' (0 2 2 2 2)
}
∇ r←y2018d3p1 path;⎕IO;f;x;y;w;h
	⎕IO←0
	f←1000 1000⍴0
	:For x y w h :in ↓y2018d3 path
		f[y+⍳h;x+⍳w]+←1
	:End
	r←2+.≤,f
∇
∇ r←y2018d3p2 path;⎕IO;f;c;x;y;w;h;i;a
	⎕IO←0
	c←y2018d3 path
	n←≢c
	f←1000 1000 n⍴0
	:For (x y w h) i :InEach (↓c) (⍳n)
		f[y+⍳h;x+⍳w;i]←1
	:End
	r←1+⊃⍸(×/c[;2 3])=+⌿+⌿f×(⍤1 0)1=+/f
∇

