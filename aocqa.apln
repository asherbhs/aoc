y2018d4←{
	x←⊃⎕NGET ⍵ 2
	xmonth←10 1+.×⍉⎕D⍳x[; 6  7] ⍝ MM-
	xday  ←10 1+.×⍉⎕D⍳x[; 9 10] ⍝   -DD
	xhour ←10 1+.×⍉⎕D⍳x[;12 13] ⍝       HH:
	xmin  ←10 1+.×⍉⎕D⍳x[;15 16] ⍝         :MM
	what  ←x[;19]               ⍝             Guard #

	⍝ assumptions: all one year, nothing on nye
	days←31 28 31 30 31 30 31 31 30 31 30 31
	xday+←xhour=23
	m←xday>days[xmonth-1]
	(m/xday)←1
	(m/xmonth)+←1

	ydate←∪⍉[xmonth ⋄ xday]
	y←(≢ydate)60⍴0

	m←what='G'
	(_ xguard)←'#'⎕VFI(,25↓(⍤1)m⌿x)∩('#',⎕D) ⋄ xguard↓⍨←1
	xdate←⍉[m/xmonth ⋄ m/xday]
	yguard←y≢⍛/0 ⋄ yguard[ydate⍳xdate]←xguard

	i←ydate⍳⍉↑xmonth xday
	m←what='f' ⋄ y[(m/i),¨(m/xmin)]←1
	m←what='w' ⋄ y[(m/i),¨(m/xmin)]←¯1
	y←+\y

	y yguard
}
