y2022d2p1←{
	(a b c x y z)←y2022d2 ⍵
	+/+/[
		x+(2×y)+(3×z)       ⍝ our choice
		3×(x∧a)∨(y∧b)∨(z∧c) ⍝ we draw
		6×(x∧c)∨(y∧a)∨(z∧b) ⍝ we win
	]
}
y2022d2p2←{
	(a b c x y z)←y2022d2 ⍵
	+/+/[
		(3×y)+(6×z)     ⍝ we draw or win
		x×b+(2×c)+(3×a) ⍝ our choice if we lose
		y×a+(2×b)+(3×c) ⍝ our choice if we draw
		z×c+(2×a)+(3×b) ⍝ our choice if we win
	]
}

