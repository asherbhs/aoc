}
y2020d4p2←{
	nl←⎕UCS 10
	ws←' ',nl
	x←nl,⍨⊃⎕NGET ⍵
	⍝ assumption: can look ahead without going oob
	p←⍸nl nl⍷x
	f←(≢p)7⍴0

	i←⍸'byr'⍷x
	n←x[i∘.+⍨4+⍳4]-⍥⎕UCS'0'
	(n i)/⍨←⊂x[i+8]∊ws
	(n i)/⍨←⊂∧⌿(0∘≤∧≤∘9)n
	i/⍨←(1920∘≤∧≤∘2002)10 10 10 10⊥n
	f[1+p⍸i;0]←1

	i←⍸'iyr'⍷x
	n←x[i∘.+⍨4+⍳4]-⍥⎕UCS'0'
	(n i)/⍨←⊂x[i+8]∊ws
	(n i)/⍨←⊂∧⌿(0∘≤∧≤∘9)n
	i/⍨←(2010∘≤∧≤∘2020)10 10 10 10⊥n
	f[1+p⍸i;1]←1

	i←⍸'eyr'⍷x
	n←x[i∘.+⍨4+⍳4]-⍥⎕UCS'0'
	(n i)/⍨←⊂x[i+8]∊ws
	(n i)/⍨←⊂∧⌿(0∘≤∧≤∘9)n
	i/⍨←(2020∘≤∧≤∘2030)10 10 10 10⊥n
	f[1+p⍸i;2]←1

	i←⍸'hgt'⍷x
	y←x[i∘.+⍨4+⍳5]
	cm←⍸(y[3;]='c')∧(y[4;]='m')
	in←⍸(y[2;]='i')∧(y[3;]='n')
	cm/⍨←x[i[cm]+9]∊ws
	in/⍨←x[i[in]+8]∊ws
	ncm←y[0 1 2;cm]-⍥⎕UCS'0'
	nin←y[0 1;  in]-⍥⎕UCS'0'
	(ncm cm)/⍨←⊂∧⌿(0∘≤∧≤∘9)ncm
	(nin in)/⍨←⊂∧⌿(0∘≤∧≤∘9)nin
	cm/⍨←(150∘≤∧≤∘193)10 10 10⊥ncm
	in/⍨← (59∘≤∧≤∘76)    10 10⊥nin
	f[1+p⍸i[cm,in];3]←1

	i←⍸'hcl'⍷x
	y←x[i∘.+⍨4+⍳7]
	(y i)/⍨←⊂x[i+11]∊ws
	(i y)/⍨←⊂'#'=⊣⌿y
	i/⍨←∧⌿'0123456789abcdef'∊⍨1↓y
	f[1+p⍸i;4]←1

	i←⍸'ecl'⍷x
	y←x[i∘.+4+⍳3]
	(y i)⌿⍨←⊂x[i+7]∊ws
	i/⍨←7>['amb' ⋄ 'blu' ⋄ 'brn' ⋄ 'gry' ⋄ 'grn' ⋄ 'hzl' ⋄ 'oth']⍳y
	f[1+p⍸i;5]←1

	i←⍸'pid'⍷x
	n←x[i∘.+⍨4+⍳9]-⍥⎕UCS'0'
	(n i)/⍨←⊂x[i+13]∊ws
	i/⍨←∧⌿(0∘≤∧≤∘9)n
	f[1+p⍸i;6]←1

	+/∧/f
}

