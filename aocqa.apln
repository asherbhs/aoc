y2019d3p1←{
	(_ ax ay _ bx by)←y2019d3 ⍵
	axibx←((0=+⌿)∧(¯1=×⌿))(1 ¯1↓(⍤0 1)bx)(∘.<-∘.>)¯1↓ax
	ayiby←((0=+⌿)∧(¯1=×⌿))(1 ¯1↓(⍤0 1)by)(∘.<-∘.>)¯1↓ay
	bxiax←((0=+⌿)∧(¯1=×⌿))(1 ¯1↓(⍤0 1)ax)(∘.<-∘.>)¯1↓bx
	byiay←((0=+⌿)∧(¯1=×⌿))(1 ¯1↓(⍤0 1)ay)(∘.<-∘.>)¯1↓by
	d ←⌊/ax[i]+⍥|by[j]⊣(i j)←↓⍉↑⍸byiay∧⍉axibx
	d⌊←⌊/bx[i]+⍥|ay[j]⊣(i j)←↓⍉↑⍸ayiby∧⍉bxiax
	d
}
y2019d3p2←{
	(as ax ay bs bx by)←y2019d3 ⍵
	axibx←((0=+⌿)∧(¯1=×⌿))(1 ¯1↓(⍤0 1)bx)(∘.<-∘.>)¯1↓ax
	ayiby←((0=+⌿)∧(¯1=×⌿))(1 ¯1↓(⍤0 1)by)(∘.<-∘.>)¯1↓ay
	bxiax←((0=+⌿)∧(¯1=×⌿))(1 ¯1↓(⍤0 1)ax)(∘.<-∘.>)¯1↓bx
	byiay←((0=+⌿)∧(¯1=×⌿))(1 ¯1↓(⍤0 1)ay)(∘.<-∘.>)¯1↓by
	d ←⌊/as[i]+bs[j]+(|ay[i]-by[j])+(|bx[j]-ax[i])⊣(i j)←↓⍉↑⍸byiay∧⍉axibx
	d⌊←⌊/bs[i]+as[j]+(|by[i]-ay[j])+(|ax[j]-bx[i])⊣(i j)←↓⍉↑⍸ayiby∧⍉bxiax
	d
}
y2019d3p2old←{
	⍝ this just simulates laying the wires consequently takes
	⍝ a lot of time and space

	⎕IO←0
	(a b)←⊃⎕NGET ⍵ 1
	P←{
		d←[0 1 ⋄ 0 ¯1 ⋄ ¯1 0 ⋄ 1 0]['UDLR'⍳⍵∩'UDLR';]
		n←⊃⌽','⎕VFI ⍵~'UDLR'
		+⍀0 0⍪n×[0]d
	}
	a←P a
	b←P b
	l←(⌊⌿a)⌊(⌊⌿b)
	u←(⌈⌿a)⌈(⌈⌿b)
	o←(+/+/|2-⌿a)⌈(+/+/|2-⌿b)
	w←(1+u-l)⍴o
	((-l)⌷w)←0
	wa←wb←w
	_←2{
		m←⍺⌊⍵
		d←|⍺-⍵
		x←(0⌷m) +⍳1+0⌷d
		y←(1⌷m) +⍳1+1⌷d
		z←(⍺⌷wa)+⍳1+⌈/d
		wa[x;y]⌊←⌽(⍣(m≢⍺))z
		1
	}/↓a-(⍤1)l
	_←2{
		m←⍺⌊⍵
		d←|⍺-⍵
		x←(0⌷m) +⍳1+0⌷d
		y←(1⌷m) +⍳1+1⌷d
		z←(⍺⌷wb)+⍳1+⌈/d
		wb[x;y]⌊←⌽(⍣(m≢⍺))z
		1
	}/↓b-(⍤1)l
	((-l)⌷wa)←o ⋄ ((-l)⌷wb)←o
	⌊/(,(o≠wa)∧(o≠wb))/,wa+wb
}

