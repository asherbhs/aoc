	n←⍵
	{
		x←+\{+/⍵}⌺3⊢⌿⍵  ⍝ next bottom row
		∨/m←x>n: ⊃m/x   ⍝ found answer?
		∇ ⌽⍉⍵⍪x         ⍝ add next batch, rotate, go again
	}1 2⍴1
}

y2018d3←{
	x←⊃⎕NGET ⍵
	x[⍸x∊'@:x']←','
	⎕CSV x 'S' (0 2 2 2 2)
}
∇ r←y2018d3p1 path;⎕IO;f;x;y;w;h
	⎕IO←0
	f←1000 1000⍴0
	:For x y w h :in ↓y2018d3 path
		f[y+⍳h;x+⍳w]+←1
	:End
	r←2+.≤,f
∇
∇ r←y2018d3p2 path;⎕IO;f;c;x;y;w;h;i;a
	⎕IO←0
	c←y2018d3 path
	n←≢c
	f←1000 1000 n⍴0
	:For (x y w h) i :InEach (↓c) (⍳n)
		f[y+⍳h;x+⍳w;i]←1
	:End
	r←1+⊃⍸(×/c[;2 3])=+⌿+⌿f×(⍤1 0)1=+/f
∇

⍝ NB. I assume the two wires never intersect while parallel: --XX--
y2019d3←{
	⎕IO←0
	(a b)←⊃⎕NGET ⍵ 1
	P←{
		d←[0 1 ⋄ 0 ¯1 ⋄ ¯1 0 ⋄ 1 0]['UDLR'⍳⍵∩'UDLR';]
		(_ n)←','⎕VFI ⍵~'UDLR'
		(⊂0,¯1↓+\n),↓⍉+⍀0 0⍪n×[0]d  ⍝ prefix steps, x positions, y positions
	}
	(as ax ay)←P a
	(bs bx by)←P b
	(axl ayl bxl byl)←¯1↓¨ax ay bx by               ⍝ shape:   is:
	axibx←((0=+⌿)∧(¯1=×⌿))[bxl ⋄ 1↓bx](∘.<-∘.>)axl  ⍝ b-1 a-1  vertical   a in b segment
	ayiby←((0=+⌿)∧(¯1=×⌿))[byl ⋄ 1↓by](∘.<-∘.>)ayl  ⍝ b-1 a-1  horizontal a in b segment
	bxiax←((0=+⌿)∧(¯1=×⌿))[axl ⋄ 1↓ax](∘.<-∘.>)bxl  ⍝ a-1 b-1  vertical   b in a segment
	byiay←((0=+⌿)∧(¯1=×⌿))[ayl ⋄ 1↓ay](∘.<-∘.>)byl  ⍝ a-1 b-1  horizontal b in a segment
	(i j)←↓⍉↑⍸byiay∧⍉axibx  ⍝ vertical a intersects horizontal b
	(k l)←↓⍉↑⍸ayiby∧⍉bxiax  ⍝ vertical b intersects vertical a
	as ax ay bs bx by i j k l
}
y2019d3p1←{
	(_ ax ay _ bx by i j k l)←y2019d3 ⍵
	d←⌊/ax[i]+⍥|by[j]
	d⌊⌊/bx[k]+⍥|ay[l]
}
y2019d3p2←{
	(as ax ay bs bx by i j k l)←y2019d3 ⍵
	d←⌊/as[i]+bs[j]+(|ay[i]-by[j])+(|bx[j]-ax[i])
	d⌊⌊/bs[k]+as[l]+(|by[k]-ay[l])+(|ax[l]-bx[k])
}
y2019d3p2old←{
	⍝ this just simulates laying the wires and consequently
	⍝ takes a lot of time and space

	⎕IO←0
	(a b)←⊃⎕NGET ⍵ 1
	P←{
		d←[0 1 ⋄ 0 ¯1 ⋄ ¯1 0 ⋄ 1 0]['UDLR'⍳⍵∩'UDLR';]
		n←⊃⌽','⎕VFI ⍵~'UDLR'
		+⍀0 0⍪n×[0]d
	}
	a←P a
	b←P b
	l←(⌊⌿a)⌊(⌊⌿b)
	u←(⌈⌿a)⌈(⌈⌿b)
	o←(+/+/|2-⌿a)⌈(+/+/|2-⌿b)
	w←(1+u-l)⍴o
	((-l)⌷w)←0
	wa←wb←w
	_←2{
		m←⍺⌊⍵
		d←|⍺-⍵
		x←(0⌷m) +⍳1+0⌷d
		y←(1⌷m) +⍳1+1⌷d
		z←(⍺⌷wa)+⍳1+⌈/d
		wa[x;y]⌊←⌽(⍣(m≢⍺))z
		1
	}/↓a-(⍤1)l
	_←2{
		m←⍺⌊⍵
		d←|⍺-⍵
		x←(0⌷m) +⍳1+0⌷d
		y←(1⌷m) +⍳1+1⌷d
		z←(⍺⌷wb)+⍳1+⌈/d
		wb[x;y]⌊←⌽(⍣(m≢⍺))z
		1
	}/↓b-(⍤1)l
	((-l)⌷wa)←o ⋄ ((-l)⌷wb)←o
	⌊/(,(o≠wa)∧(o≠wb))/,wa+wb
}

