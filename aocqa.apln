y2022d3p2←{⎕IO←1 ⋄ x←⊃⎕NGET ⍵ 1 ⋄ +/(⎕C⍛,⎕A)⍳⊃¨∩/(3÷⍨≢x)3⍴x}

y2023d3←{
	⎕IO←0
	x←⊃⎕NGET ⍵ 2
	x,←'.'  ⍝ defensive: separate numbers in ravel
	y←,x
	m←y∊⎕D
	n←⌽10⊥10|⎕D⍳⍉⌽↑m⊆⍥⌽y
	x y m n
}
y2023d3p1←{
	(x _ m n)←y2023d3 ⍵
	+/n/⍨m(∨/¨⊆),{∨/,⍵}(⌺3 3)~x∊' .',⎕D
}
y2023d3p2←{
	⎕IO←0
	(x y m n)←y2023d3 ⍵
	id←x⍴⍛⍴1↓∪⍛⍳(+\~)⍛×0,m           ⍝ id for each number
	g←⍸x='*'                         ⍝ prospective gears (nested indices yuck)
	p←↓id[(⍴x)∘⌊¨0⌈g∘.+,∘.,⍨¯1 0 1]  ⍝ prospective gear parts
	+/×/(1,n)[↑(3=≢¨)⍛/∪¨p]          ⍝ ratio sum of real gears
}

y2024d3←{
	(x i)←⍵
	z←0
	a←b←i×0
	s←i×0                                           ⍝ state: 012345678
	S←{                                             ⍝        (nnn,nnn)
		i+←1 ⋄ i/⍨←i<≢x ⋄ xi←x[i]                   ⍝ advance
		d←xi∊⎕D ⋄ c←xi=',' ⋄ p←xi=')'               ⍝ what we got
		m←(d∧s∊0 1 2 4 5 6)∨(c∧s∊1 2 3)∨(p∧s∊5 6 7) ⍝ ok
		(s i xi d c p a b)/⍨←⊂m                     ⍝ keep
		s+←1 ⋄ s⌈←(4×c)+(8×p)                       ⍝ next
		m←s∊1 2 3 ⋄ (m/a)×←10 ⋄ (m/a)+←⎕D⍳m/xi      ⍝ (nnn,   )
		m←s∊5 6 7 ⋄ (m/b)×←10 ⋄ (m/b)+←⎕D⍳m/xi      ⍝ (   ,nnn)
		m←s=8 ⋄ z+←+/(m/a)×(m/b) ⋄ (s i a b)/⍨←⊂~m  ⍝ finished
	1}
	z⊣S¨⍳8
}
y2024d3p1←{
	x←⊃⎕NGET ⍵
	i←3+⍸'mul('⍷x
	y2024d3 x i
}
y2024d3p2←{
	x←⊃⎕NGET ⍵
	i←3+⍸'mul('⍷x
	y← 0,⍸'do()'⍷x
	n←¯1,⍸'don''t()'⍷x
	i/⍨←y[y⍸i]>n[n⍸i]
	y2024d3 x i
}

