	guard←⊃⊃{⍺/⍨⌈/⍛=⍵}/↓⍉yguard{⍺,+/⍵}⌸+/y
	guard×(⊢⍳⌈/)+⌿y⌿⍨yguard=guard
}
y2018d4p2←{
